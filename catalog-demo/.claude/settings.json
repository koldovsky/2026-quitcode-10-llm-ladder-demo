{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Read(./**)",
      "Glob",
      "Grep",
      "Edit(./catalog/**)",
      "Bash(mv *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Bash(rm *)",
      "Bash(cat *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(node *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(cmd *)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
